<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- GPUI's Metal/wgpu shader pipeline generates and executes code at runtime, which the
         default hardened runtime blocks. These mirror Zed's own entitlements for the same
         GPUI stack. Not sandboxed: Developer ID apps distributed outside the Mac App Store
         don't need App Sandbox, and Kubyl needs unrestricted filesystem/network/keychain
         access for kubeconfigs and cluster connections. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- The data protection keychain (kubyl_kube::auth::store): items belong to this access
         group, so macOS never asks for keychain access, not even after an update. Restricted
         entitlements: macOS only starts Kubyl with them when the embedded provisioning profile
         (Contents/embedded.provisionprofile, see docs/RELEASING.md) grants them. -->
    <key>com.apple.application-identifier</key>
    <string>7RJB3ZHA5M.io.github.birkneralex.Kubyl</string>
    <key>com.apple.developer.team-identifier</key>
    <string>7RJB3ZHA5M</string>
    <key>keychain-access-groups</key>
    <array>
        <string>7RJB3ZHA5M.io.github.birkneralex.Kubyl</string>
    </array>
</dict>
</plist>
